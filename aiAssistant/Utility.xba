<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Utility" script:language="StarBasic" script:moduleType="normal">REM  *****  BASIC  *****

Sub Main

End Sub


Global oConfigDialog As Object


Sub ShowConfigDialog()
    Dim apiUrl As String	&apos;API URL
    Dim apiKey As String	&apos;API KEY
    Dim modelName As String	&apos;MODEL NAME
    
    &apos; 讀取先前儲存的全域屬性值
    apiUrl = GetUserConfig(&quot;ConfigValue1&quot;, &quot;&quot;)
    apiKey = GetUserConfig(&quot;ConfigValue2&quot;, &quot;&quot;)
    modelName = GetUserConfig(&quot;ConfigValue3&quot;, &quot;&quot;)
    
    &apos; 創建並顯示對話框
    oConfigDialog = CreateUnoDialog(DialogLibraries.aiAssistant.dlgConfig)
    
    &apos; 將屬性值填入對話框的文字框
    oConfigDialog.getControl(&quot;ConfigField1&quot;).Text = apiUrl
    oConfigDialog.getControl(&quot;ConfigField2&quot;).Text = apiKey
    oConfigDialog.getControl(&quot;ConfigField3&quot;).Text = modelName
    
    &apos; 顯示對話框，按下確定後才繼續執行
    If oConfigDialog.execute() = 1 Then
        &apos; 取得使用者輸入的值
        apiUrl = oConfigDialog.getControl(&quot;ConfigField1&quot;).Text
        apiKey = oConfigDialog.getControl(&quot;ConfigField2&quot;).Text
        modelName = oConfigDialog.getControl(&quot;ConfigField3&quot;).Text
        
        &apos; 儲存到全域配置中
        SetUserConfig(&quot;ConfigValue1&quot;, apiUrl)
        SetUserConfig(&quot;ConfigValue2&quot;, apiKey)
        SetUserConfig(&quot;ConfigValue3&quot;, modelName)
    End If
    
    oConfigDialog.endDialog(1)
End Sub

Sub btn_save(e)

	dlg = e.Source.context
	
	dlg.endDialog(1)

End Sub


&apos; 從外部文字檔讀取配置值
Function GetUserConfig(configKey As String, sDefault As String) As String
&apos;    On Error GoTo ErrorHandler
    Dim sFilePath As String
    sFilePath = GetConfigFilePath()
    
    Dim sLine As String, arr() As String
    Dim oFile As Integer
    oFile = FreeFile
    
    Open sFilePath For Input As oFile
    Do Until EOF(oFile)
        Line Input #oFile, sLine
        arr = Split(sLine, &quot;=&quot;)
        If arr(0) = configKey Then
            GetUserConfig = arr(1)
            Close #oFile
            Exit Function
        End If
    Loop
    Close #oFile
    
&apos;ErrorHandler:
&apos;    GetUserConfig = sDefault
End Function

REM  *****  BASIC  *****

private Sub MapTest
	Dim configMap As Object
    configMap = com.sun.star.container.EnumerableMap.create(&quot;string&quot;, &quot;string&quot;) &apos; 創建 Map 物件
    sLine = &quot;username=admin&quot;
    arr = Split(sLine, &quot;=&quot;)

    If UBound(arr) = 1 Then
        configMap.put(arr(0), arr(1)) &apos; 新增鍵值對
    End If
    configMap.remove(arr(0))
    configMap.put(arr(0), &quot;admin2&quot;)
    
    enu = configMap.createKeyEnumeration(False)
    
    Do While enu.hasMoreElements
	    elem = enu.nextElement
    	MsgBox(&quot;Key : &quot; &amp; elem)
    	MsgBox(&quot;Value: &quot; &amp; configMap.get(elem))
	Loop

End Sub

&apos; 儲存配置值到外部文字檔
Sub SetUserConfig(configKey As String, configValue As String)
    Dim sFilePath As String
    sFilePath = GetConfigFilePath()
    
    Dim oFile As Integer
    Dim sLine As String, arr() As String
    Dim configMap As Object
    configMap = com.sun.star.container.EnumerableMap.create(&quot;string&quot;, &quot;string&quot;) &apos; 創建 Map 物件
    
    &apos; 檢查檔案是否存在，若不存在，直接建立空 Map
    If FileExists(sFilePath) Then
        oFile = FreeFile
        Open sFilePath For Input As #oFile
        Do Until EOF(oFile)
            Line Input #oFile, sLine
            arr = Split(sLine, &quot;=&quot;)
            If UBound(arr) = 1 Then
                configMap.put(Trim(arr(0)), Trim(arr(1))) &apos; 新增鍵值對
            End If
        Loop
        Close #oFile
    End If
    
    
    &apos; 更新或新增指定的配置項目
    If configMap.containsKey(configKey) Then
        configMap.remove(configKey)
	    configMap.put(configKey, configValue)
    Else
        configMap.put(configKey, configValue) &apos; 新增鍵值對
    End If
    
    &apos; 寫回更新後的配置
    oFile = FreeFile
    Open sFilePath For Output As #oFile
    
    enu = configMap.createKeyEnumeration(False)
    Do While enu.hasMoreElements
    	key = enu.nextElement
    	Print #oFile, key &amp; &quot;=&quot; &amp; configMap.get(key)
    Loop

    Close #oFile
End Sub

&apos; 設定檔案路徑
Function GetConfigFilePath() As String
    &apos; 設定檔案儲存在應用程式的設定資料夾中
    GetConfigFilePath = Environ(&quot;APPDATA&quot;) &amp; &quot;\MODAODFApplicationTools\3\user\ModaODFAIConfig.txt&quot;
End Function

Function SendOpenAIRequest(messages As String) As String
    Dim http As Object
    Dim url As String
    Dim requestBody As String
    Dim response As String
    
    &apos; OpenAI API URL
    url =  Utility.GetUserConfig(&quot;ConfigValue1&quot;, &quot;&quot;)	&apos; api
  	apiKey =  Utility.GetUserConfig(&quot;ConfigValue2&quot;, &quot;&quot;)	&apos; key
	modelName = Utility.GetUserConfig(&quot;ConfigValue3&quot;, &quot;&quot;)	&apos; modelName
    
    &apos; 設定請求的 JSON 內容
    requestBody = &quot;{&quot;&quot;model&quot;&quot;: &quot;&quot;&quot; &amp; modelName &amp; &quot;&quot;&quot;, &quot;&quot;messages&quot;&quot;: &quot; &amp; messages &amp; &quot;, &quot;&quot;temperature&quot;&quot;: 0.7}&quot;
    
    &apos; 建立 XMLHTTP 物件
    Set http = CreateObject(&quot;MSXML2.XMLHTTP.6.0&quot;)
    
    &apos; 配置 HTTP POST 請求
    http.Open &quot;POST&quot;, url, False
    http.setRequestHeader &quot;Content-Type&quot;, &quot;application/json&quot;
    http.setRequestHeader &quot;Authorization&quot;, &quot;Bearer &quot; &amp; apiKey
    
    &apos; 發送請求
    &apos;msgbox requestBody
    http.send requestBody
    
    &apos; 取得回應
    If http.Status = 200 Then
        &apos; 成功時解析回應
        response = http.responseText
    Else
        &apos; 發生錯誤時回傳錯誤代碼
        response = &quot;Error: &quot; &amp; http.Status &amp; &quot; - &quot; &amp; http.statusText
    End If
    
    SendOpenAIRequest = response
End Function


</script:module>